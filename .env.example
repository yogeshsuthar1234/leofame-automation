# Which free trial to claim: followers | likes | views
CLAIM_TYPE=likes

# Used when CLAIM_TYPE=followers (your own Instagram username, public profile)
INSTAGRAM_USERNAME=your_username_here

# Used when CLAIM_TYPE=likes or CLAIM_TYPE=views (link to your own public post)
INSTAGRAM_POST_URL=https://www.instagram.com/p/your_post_id/

# Set to false to watch the browser locally, true for headless (CI default)
HEADLESS=true
